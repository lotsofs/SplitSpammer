<Project Sdk="Microsoft.NET.Sdk">
  <!-- SDK-style so C# Dev Kit can load it (it rejects traditional .NET Framework projects). Net481 because LiveSplit targets it from 1.8.30. -->
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>LiveSplit.SplitSpammer</RootNamespace>
    <AssemblyName>LiveSplit.SplitSpammer</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- Output stays in bin\<config>\, which deploy.cmd copies from -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Properties\AssemblyInfo.cs holds the assembly attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LiveSplitDir Condition=" '$(LiveSplitDir)' == '' ">$(MSBuildProjectDirectory)\..\..\Programs\Streaming\LiveSplit</LiveSplitDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <DebugType>full</DebugType>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DebugType>pdbonly</DebugType>
    <DefineConstants>TRACE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- Source files are included by default; these folders hold other projects -->
    <Compile Remove="Preview\**" />
    <Compile Remove="Tests\**" />
    <Compile Remove="reference\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Private=False: LiveSplit already has these, so the build doesn't copy them into bin\ -->
    <Reference Include="LiveSplit.Core">
      <HintPath>$(LiveSplitDir)\LiveSplit.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="UpdateManager">
      <HintPath>$(LiveSplitDir)\UpdateManager.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
